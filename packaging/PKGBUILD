# Maintainer: isra <israelzermeno82@gmail.com>
pkgname=dmgr
pkgver=2.0.0
pkgrel=1
pkgdesc="Device Manager for Arch Linux — egui native GUI with audio switching"
arch=('x86_64')
url="https://github.com/Khinmmad/dmgr"
license=('MIT')
depends=('polkit' 'libxkbcommon' 'wayland' 'libgl')
optdepends=(
    'pipewire-pulse: audio device switching support'
    'pulseaudio: audio device switching support'
)
makedepends=('rust' 'cargo' 'pkg-config')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked \
        -p dmgr-gui \
        -p dmgr-polkit-helper
}

package() {
    cd "$pkgname-$pkgver"

    # Main GUI binary
    install -Dm755 target/release/dmgr \
        "$pkgdir/usr/bin/dmgr"

    # Privileged helper (invoked via pkexec)
    install -Dm755 target/release/dmgr-polkit-helper \
        "$pkgdir/usr/bin/dmgr-polkit-helper"

    # Polkit policy
    install -Dm644 resources/org.dmgr.DeviceManager.policy \
        "$pkgdir/usr/share/polkit-1/actions/org.dmgr.DeviceManager.policy"

    # Desktop entry
    install -Dm644 resources/dmgr.desktop \
        "$pkgdir/usr/share/applications/dmgr.desktop"

    # License
    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
