{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dmgr-desktop",
  "version": "2.1.3",
  "identifier": "org.dmgr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dmgr — Device Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "publisher": "Khinmmad",
    "copyright": "Copyright © 2026 isra (Khinmmad) — MIT License",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Device manager for Linux & Windows",
    "longDescription": "A modern device manager: browse and manage devices, drivers, audio outputs, Bluetooth and kernel modules. Built with Tauri + React.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "policykit-1"],
        "files": {
          "/usr/bin/dmgr-polkit-helper": "../../target/release/dmgr-polkit-helper",
          "/usr/share/polkit-1/actions/org.dmgr.DeviceManager.policy": "../../resources/org.dmgr.DeviceManager.policy"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "polkit"],
        "files": {
          "/usr/bin/dmgr-polkit-helper": "../../target/release/dmgr-polkit-helper",
          "/usr/share/polkit-1/actions/org.dmgr.DeviceManager.policy": "../../resources/org.dmgr.DeviceManager.policy"
        }
      }
    }
  }
}
